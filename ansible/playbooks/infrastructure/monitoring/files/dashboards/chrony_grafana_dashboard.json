        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "chrony_sources_last_sample_offset_seconds{job=\"chrony\",source_name=~\"AC|NIC\"}",
          "legendFormat": "{{source_name}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "chrony_sources_last_sample_error_margin_seconds{job=\"chrony\",source_name=\"AC\"}",
          "legendFormat": "AC error margin",
          "refId": "B"
