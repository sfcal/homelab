    {
      "id": 13,
      "type": "timeseries",
      "title": "Frequency (ppm) + CPU Temperature",
      "description": "Autoscaled, NOT zero-centered: the oscillator sits near -33 ppm and the signal is the shape. CPU temp on right axis to correlate thermal drift.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
