    {
      "id": 17,
      "type": "timeseries",
      "title": "Root Delay / Dispersion / Worst-Case Error",
      "description": "Dispersion grows between updates and resets on each \u2014 the sawtooth is the heartbeat. 15 s step, no averaging: a stalled sawtooth means the source went quiet.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "chrony_tracking_root_delay_seconds{job=\"chrony\"}",
          "legendFormat": "root delay",
          "refId": "A",
          "interval": "15s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "chrony_tracking_root_dispersion_seconds{job=\"chrony\"}",
          "legendFormat": "root dispersion",
          "refId": "B",
          "interval": "15s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "chrony_tracking_root_delay_seconds{job=\"chrony\"} / 2 + chrony_tracking_root_dispersion_seconds{job=\"chrony\"}",
          "legendFormat": "worst-case error (delay/2 + dispersion)",
          "refId": "C",
          "interval": "15s"
