    {
      "id": 8,
      "type": "timeseries",
      "title": "Tracking Offset (selected source)",
      "description": "Selected-source offsets. PHC-locked steady state is tens of ns; anything in the \u00b5s range means fallback. Refclock updates at 1 Hz, scraped at 15 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "chrony_tracking_last_offset_seconds{job=\"chrony\"}",
          "legendFormat": "last offset",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "chrony_tracking_system_time_seconds{job=\"chrony\"}",
          "legendFormat": "system time offset",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "pointSize": 4,
            "showPoints": "auto",
            "spanNulls": false,
            "axisCenteredZero": true,
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max",
            "min"
          ]
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Refclocks vs System Clock",
      "description": "AC = Timecard PHC, NIC = i226 PHC (noselect, ts2phc-disciplined). Divergence between them or vs zero indicates a broken segment.",
