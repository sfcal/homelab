          },
          "expr": "chrony_tracking_frequency_ppms{job=\"chrony\"}",
          "legendFormat": "frequency (ppm)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(node_hwmon_temp_celsius{job=\"node\",chip=\"platform_coretemp_0\"})",
