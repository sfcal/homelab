---
# Grafana panels from the "System Activity" dashboard (files/dashboards/system_activity.json)
- System Activity:
    - CPU:
        href: {{ grafana_url }}/d/system-activity
        widget:
          type: iframe
          name: cpu
          src: {{ grafana_url }}/d-solo/system-activity?panelId=1&theme=dark&hideLogo=true

    - Memory:
        href: {{ grafana_url }}/d/system-activity
        widget:
          type: iframe
          name: memory
          src: {{ grafana_url }}/d-solo/system-activity?panelId=2&theme=dark&hideLogo=true

    - Network:
        href: {{ grafana_url }}/d/system-activity
        widget:
          type: iframe
          name: network
          src: {{ grafana_url }}/d-solo/system-activity?panelId=3&theme=dark&hideLogo=true

    - Disk I/O:
        href: {{ grafana_url }}/d/system-activity
        widget:
          type: iframe
          name: disk
          src: {{ grafana_url }}/d-solo/system-activity?panelId=4&theme=dark&hideLogo=true

- Media Management:
    - Sonarr:
        icon: sonarr.png
        href: https://sonarr.5am.video
        siteMonitor: http://10.2.0.5:8989
        widget:
          type: sonarr
          url: http://10.2.0.5:8989
          key: {% raw %}{{HOMEPAGE_VAR_SONARR_KEY}}{% endraw %}

    - Radarr:
        icon: radarr.png
        href: https://radarr.5am.video
        siteMonitor: http://10.2.0.5:7878
        widget:
          type: radarr
          url: http://10.2.0.5:7878
          key: {% raw %}{{HOMEPAGE_VAR_RADARR_KEY}}{% endraw %}

    - Bazarr:
        icon: bazarr.png
        href: https://bazarr.5am.video
        siteMonitor: http://10.2.0.5:6767
        widget:
          type: bazarr
          url: http://10.2.0.5:6767
          key: {% raw %}{{HOMEPAGE_VAR_BAZARR_KEY}}{% endraw %}

    - Prowlarr:
        icon: prowlarr.png
        href: https://prowlarr.5am.video
        siteMonitor: http://10.2.0.5:9696
        widget:
          type: prowlarr
          url: http://10.2.0.5:9696
          key: {% raw %}{{HOMEPAGE_VAR_PROWLARR_KEY}}{% endraw %}

- Downloads:
    - SABnzbd:
        icon: sabnzbd.png
        href: https://sabnzbd.5am.video
        siteMonitor: http://10.2.0.5:8080
        widgets:
          - type: sabnzbd
            url: http://10.2.0.5:8080
            key: {% raw %}{{HOMEPAGE_VAR_SABNZBD_KEY}}{% endraw %}

          # Download totals from SABnzbd's statistics
          - type: customapi
            url: http://10.2.0.5:8080/api?mode=server_stats&apikey={% raw %}{{HOMEPAGE_VAR_SABNZBD_KEY}}{% endraw %}&output=json
            refreshInterval: 60000  # once a minute; the 10 s default errors when SABnzbd closes the idle connection
            mappings:
              - field: day
                label: Today
                format: bytes
              - field: week
                label: Week
                format: bytes
              - field: month
                label: Month
                format: bytes
              - field: total
                label: Total
                format: bytes

- Media Processing:
    - Tdarr:
        icon: tdarr.png
        href: https://tdarr.5am.video
        siteMonitor: http://10.2.0.5:8265
        widget:
          type: tdarr
          url: http://10.2.0.5:8265

    - Plex:
        icon: plex.png
        href: https://plex.5am.video
        widget:
          type: plex
          url: http://10.2.0.5:32400
          key: {% raw %}{{HOMEPAGE_VAR_PLEX_KEY}}{% endraw %}

    - Frigate:
        icon: frigate.png
        href: https://frigate.5am.video
        siteMonitor: http://10.2.0.5:5000
        widget:
          type: frigate
          url: http://10.2.0.5:5000

# grafana and prometheus are the containers next to Homepage in compose.yaml
- Monitoring:
    - Grafana:
        icon: grafana.png
        href: {{ grafana_url }}
        siteMonitor: http://grafana:3000

    - Prometheus:
        icon: prometheus.png
        href: {{ prometheus_url }}
        siteMonitor: http://prometheus:9090
        widget:
          type: prometheus
          url: http://prometheus:9090

    - Uptime Kuma:
        icon: uptime-kuma.png
        href: https://uptime.ext.5am.cloud
        siteMonitor: http://178.156.190.134:3001
        widget:
          type: uptimekuma
          url: http://178.156.190.134:3001
          slug: default

- Node Exporters:
{% for target in prometheus_node_targets %}
    - {{ target.split(':')[0] }}:
        icon: prometheus.png
        siteMonitor: http://{{ target }}
        widget:
          type: prometheusmetric
          url: http://prometheus:9090
          metrics:
            - label: CPU Usage
              query: 100 - (avg by (instance) (irate(node_cpu_seconds_total{mode="idle", instance="{{ target }}"}[5m])) * 100)
              format:
                type: percent
{% endfor %}
