global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node-exporter'
    static_configs:
      - targets:
{% for target in prometheus_node_targets %}
          - '{{ target }}'
{% endfor %}
{% if prometheus_chrony_targets | default([]) | length > 0 %}

  - job_name: 'chrony'
    static_configs:
      - targets:
{% for target in prometheus_chrony_targets %}
          - '{{ target }}'
{% endfor %}
{% endif %}
