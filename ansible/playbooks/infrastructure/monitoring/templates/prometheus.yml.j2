global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node-exporter'
    static_configs:
      - targets:
{% for target in prometheus_node_targets %}
          - '{{ target }}'
{% endfor %}
{% if prometheus_chrony_targets | default([]) | length > 0 %}

  - job_name: 'chrony'
    static_configs:
      - targets:
{% for target in prometheus_chrony_targets %}
          - '{{ target }}'
{% endfor %}
{% endif %}
{% if prometheus_gpsd_targets | default([]) | length > 0 %}

  - job_name: 'gpsd'
    static_configs:
      - targets:
{% for target in prometheus_gpsd_targets %}
          - '{{ target }}'
{% endfor %}
{% endif %}
{% if prometheus_ptp_node_targets | default([]) | length > 0 %}

  # Named 'node' (not merged into node-exporter): the Chrony dashboard's
  # coretemp panel averages node_hwmon_temp_celsius{job="node"} unscoped,
  # so this job must contain only the PTP grandmaster.
  - job_name: 'node'
    static_configs:
      - targets:
{% for target in prometheus_ptp_node_targets %}
          - '{{ target }}'
{% endfor %}
{% endif %}

  # Every name the site's Caddy serves (the loop is the Caddyfile's), requested
  # by blackbox-exporter (compose.yaml.j2) once a minute. A request shows
  # whether the name resolves, Caddy answers and its certificate is valid.
  # `instance` is the name; the address scraped is blackbox-exporter's.
  - job_name: 'blackbox'
    scrape_interval: 1m
    metrics_path: /probe
    params:
      module: [http]
    static_configs:
      - targets:
{% for service in services if service.proxied | default(false) and service.enabled | default(true) %}
          - 'https://{{ service.name }}.{{ service.domain }}'
{% endfor %}
{% for target in prometheus_blackbox_targets | default([]) %}
          - '{{ target }}'
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115
