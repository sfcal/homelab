global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node-exporter'
    static_configs:
      - targets:
{% for target in prometheus_node_targets %}
          - '{{ target }}'
{% endfor %}
{% if prometheus_chrony_targets | default([]) | length > 0 %}

  - job_name: 'chrony'
    static_configs:
      - targets:
{% for target in prometheus_chrony_targets %}
          - '{{ target }}'
{% endfor %}
{% endif %}
{% if prometheus_gpsd_targets | default([]) | length > 0 %}

  - job_name: 'gpsd'
    static_configs:
      - targets:
{% for target in prometheus_gpsd_targets %}
          - '{{ target }}'
{% endfor %}
{% endif %}
{% if prometheus_ptp_node_targets | default([]) | length > 0 %}

  # Named 'node' (not merged into node-exporter): the Chrony dashboard's
  # coretemp panel averages node_hwmon_temp_celsius{job="node"} unscoped,
  # so this job must contain only the PTP grandmaster.
  - job_name: 'node'
    static_configs:
      - targets:
{% for target in prometheus_ptp_node_targets %}
          - '{{ target }}'
{% endfor %}
{% endif %}
