---
networks:
  monitoring:
    driver: bridge

services:
  prometheus:
    image: {{ prometheus_image }}
    container_name: prometheus
    restart: unless-stopped
    mem_limit: 2g
    mem_reservation: 1g
    networks:
      - monitoring
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time={{ prometheus_retention }}'
      - '--web.console.libraries=/etc/prometheus/console_libraries'
      - '--web.console.templates=/etc/prometheus/consoles'
      - '--web.enable-lifecycle'
    ports:
      - "9090:9090"
    volumes:
      - /opt/monitoring/prometheus:/etc/prometheus:ro
      - /var/lib/monitoring/prometheus:/prometheus
    user: "{{ monitoring_uid }}:{{ monitoring_gid }}"

  # Requests every name the site's Caddy serves, the way a browser on the LAN
  # does: the site's DNS, Caddy and its certificate. Prometheus reads the
  # results (job 'blackbox' in prometheus.yml.j2). No published port: only
  # Prometheus asks it, as blackbox-exporter:9115.
  blackbox-exporter:
    image: {{ blackbox_exporter_image }}
    container_name: blackbox-exporter
    restart: unless-stopped
    mem_limit: 128m
    networks:
      - monitoring
    command:
      - '--config.file=/etc/blackbox/blackbox.yml'
    volumes:
      - /opt/monitoring/blackbox:/etc/blackbox:ro
{% if victorialogs_image is defined %}

  # The logs of every VM, the VPS and their containers (wil only: the site
  # that sets victorialogs_image). Vector on each of them (roles/vector)
  # sends to port 9428. Read it there too: /select/vmui in a browser,
  # /select/logsql/query with curl. No login, like Prometheus. Docker makes
  # the data directory on first start.
  victorialogs:
    image: {{ victorialogs_image }}
    container_name: victorialogs
    restart: unless-stopped
    mem_limit: 1g
    networks:
      - monitoring
    command:
      - '-storageDataPath=/victoria-logs-data'
      - '-retentionPeriod=30d'
    ports:
      - "9428:9428"
    volumes:
      - /var/lib/monitoring/victorialogs:/victoria-logs-data
{% endif %}
