# Managed by Ansible: ansible/playbooks/infrastructure/proxmox
[Unit]
Description=SR-IOV VFs for the Intel Arc Pro B50
# pve-guests starts the on-boot VMs; those with hostpci mappings need the VFs first.
Before=pve-guests.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=120
ExecStart=/usr/local/sbin/sriov-b50

[Install]
WantedBy=multi-user.target
