- Infrastructure (ldn):
    - Proxmox:
        icon: proxmox.png
        description: Hypervisor
        href: https://vm.ldn.5am.cloud
        siteMonitor: https://10.3.20.10:8006

    - KVM:
        icon: mdi-monitor-dashboard
        description: Remote console
        href: https://kvm.ldn.5am.cloud
        siteMonitor: http://10.3.30.227:80

    - Netboot:
        icon: netboot.png
