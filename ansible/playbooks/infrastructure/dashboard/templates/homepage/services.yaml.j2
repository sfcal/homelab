# Same targets as prometheus_node_targets in site_<site>/infra_monitoring/prometheus.yml
- Node Exporters (wil):
{% for target in ['10.2.20.30:9100', '10.2.0.5:9100', '10.2.20.53:9100', '10.2.20.45:9100'] %}
    - {{ target.split(':')[0] }}:
        icon: prometheus.png
        siteMonitor: http://{{ target }}
        widget:
          type: prometheusmetric
          url: http://10.2.20.30:9090
          metrics:
            - label: CPU Usage
              query: 100 - (avg by (instance) (irate(node_cpu_seconds_total{mode="idle", instance="{{ target }}"}[5m])) * 100)
              format:
                type: percent
{% endfor %}

- Node Exporters (ldn):
{% for target in ['10.3.20.30:9100', '10.3.20.53:9100', '10.3.20.70:9100', '10.3.20.55:9100'] %}
    - {{ target.split(':')[0] }}:
        icon: prometheus.png
