---
# One dashboard for both sites, on the OVH VPS. Widgets reach each site's LAN
# over the tailnet (the VPS accepts the sites' subnet routes).

# Grafana panels from the "System Activity" dashboard
# (dashboard/files/grafana/dashboards/system_activity.json), from the Grafana
# on this VPS; var-ds picks the site's Prometheus.
- System Activity (wil):
    - CPU:
        href: http://dashboard:3000/d/system-activity?var-ds=prometheus-wil
        widget:
          type: iframe
          name: cpu-wil
          src: http://dashboard:3000/d-solo/system-activity?var-ds=prometheus-wil&panelId=1&theme=light&hideLogo=true

    - Memory:
        href: http://dashboard:3000/d/system-activity?var-ds=prometheus-wil
        widget:
          type: iframe
          name: memory-wil
          src: http://dashboard:3000/d-solo/system-activity?var-ds=prometheus-wil&panelId=2&theme=light&hideLogo=true

    - Network:
        href: http://dashboard:3000/d/system-activity?var-ds=prometheus-wil
        widget:
          type: iframe
          name: network-wil
          src: http://dashboard:3000/d-solo/system-activity?var-ds=prometheus-wil&panelId=3&theme=light&hideLogo=true

    - Disk I/O:
        href: http://dashboard:3000/d/system-activity?var-ds=prometheus-wil
        widget:
          type: iframe
          name: disk-wil
          src: http://dashboard:3000/d-solo/system-activity?var-ds=prometheus-wil&panelId=4&theme=light&hideLogo=true

- System Activity (ldn):
    - CPU:
        href: http://dashboard:3000/d/system-activity?var-ds=prometheus-ldn
        widget:
          type: iframe
          name: cpu-ldn
          src: http://dashboard:3000/d-solo/system-activity?var-ds=prometheus-ldn&panelId=1&theme=light&hideLogo=true

    - Memory:
        href: http://dashboard:3000/d/system-activity?var-ds=prometheus-ldn
        widget:
          type: iframe
          name: memory-ldn
          src: http://dashboard:3000/d-solo/system-activity?var-ds=prometheus-ldn&panelId=2&theme=light&hideLogo=true

    - Network:
        href: http://dashboard:3000/d/system-activity?var-ds=prometheus-ldn
        widget:
          type: iframe
          name: network-ldn
          src: http://dashboard:3000/d-solo/system-activity?var-ds=prometheus-ldn&panelId=3&theme=light&hideLogo=true

    - Disk I/O:
        href: http://dashboard:3000/d/system-activity?var-ds=prometheus-ldn
        widget:
          type: iframe
          name: disk-ldn
          src: http://dashboard:3000/d-solo/system-activity?var-ds=prometheus-ldn&panelId=4&theme=light&hideLogo=true

- Media Management:
    - Sonarr:
        icon: sonarr.png
        description: TV series
        href: https://sonarr.5am.video
        siteMonitor: http://10.2.0.5:8989
        widget:
          type: sonarr
          url: http://10.2.0.5:8989
          key: {% raw %}{{HOMEPAGE_VAR_SONARR_KEY}}{% endraw %}

    - Radarr:
        icon: radarr.png
        description: Movies
        href: https://radarr.5am.video
        siteMonitor: http://10.2.0.5:7878
        widget:
          type: radarr
          url: http://10.2.0.5:7878
          key: {% raw %}{{HOMEPAGE_VAR_RADARR_KEY}}{% endraw %}

    - Bazarr:
        icon: bazarr.png
        description: Subtitles
        href: https://bazarr.5am.video
        siteMonitor: http://10.2.0.5:6767
        widget:
          type: bazarr
          url: http://10.2.0.5:6767
          key: {% raw %}{{HOMEPAGE_VAR_BAZARR_KEY}}{% endraw %}

    - Prowlarr:
        icon: prowlarr.png
        description: Indexers
        href: https://prowlarr.5am.video
        siteMonitor: http://10.2.0.5:9696
        widget:
          type: prowlarr
          url: http://10.2.0.5:9696
          key: {% raw %}{{HOMEPAGE_VAR_PROWLARR_KEY}}{% endraw %}
          # Tints the tile (custom.css): good lime, warn orange, danger pink
          highlight:
            numberOfFailGrabs:
              numeric:
                - {level: good, when: eq, value: 0}
                - {level: warn, when: gt, value: 0}

    - Pulsarr:
        icon: pulsarr.png
        description: Plex watchlist sync
        href: https://pulsarr.5am.video
        siteMonitor: http://10.2.0.5:3003/health

    - Cleanuparr:
        icon: cleanuparr.png
        description: Download cleanup
        href: https://cleanuparr.5am.video
        siteMonitor: http://10.2.0.5:11011

    # Houndarr's read-only widget endpoint; its API key (Settings > Admin >
    # API key) opens nothing else
    - Houndarr:
        icon: houndarr.png
        description: Missing and upgrade searches
        href: https://houndarr.5am.video
        siteMonitor: http://10.2.0.5:8877/api/health
        widget:
          type: customapi
          url: http://10.2.0.5:8877/api/v1/widget
          refreshInterval: 30000
          mappings:
            - field: totals.eligible
              label: Eligible
              format: number
            - field: totals.gated
              label: Gated
              format: number
            - field: totals.unreleased
              label: Unreleased
              format: number
            - field: totals.searches_7d
              label: Searches (7d)
              format: number
          headers:
            X-Api-Key: {% raw %}{{HOMEPAGE_VAR_HOUNDARR_KEY}}{% endraw %}

- Downloads:
    - SABnzbd:
        icon: sabnzbd.png
        description: Usenet downloader
        href: https://sabnzbd.5am.video
        siteMonitor: http://10.2.0.5:8080
        widgets:
          - type: sabnzbd
            url: http://10.2.0.5:8080
            key: {% raw %}{{HOMEPAGE_VAR_SABNZBD_KEY}}{% endraw %}

          # Download totals from SABnzbd's statistics
          - type: customapi
            url: http://10.2.0.5:8080/api?mode=server_stats&apikey={% raw %}{{HOMEPAGE_VAR_SABNZBD_KEY}}{% endraw %}&output=json
            refreshInterval: 60000  # once a minute; the 10 s default errors when SABnzbd closes the idle connection
            mappings:
              - field: day
                label: Today
                format: bytes
              - field: week
                label: Week
                format: bytes
              - field: month
                label: Month
                format: bytes
              - field: total
                label: Total
                format: bytes

- Media Processing:
    - Tdarr:
        icon: tdarr.png
        description: Transcoding
        href: https://tdarr.5am.video
        siteMonitor: http://10.2.0.5:8265
        widget:
          type: tdarr
          url: http://10.2.0.5:8265
          highlight:
            errored:
              numeric:
                - {level: good, when: eq, value: 0}
                - {level: warn, when: gt, value: 0}

    - Plex:
        icon: plex.png
        description: Media server
        href: https://plex.5am.video
        widget:
          type: plex
          url: http://10.2.0.5:32400
          key: {% raw %}{{HOMEPAGE_VAR_PLEX_KEY}}{% endraw %}

    - Frigate:
        icon: frigate.png
        description: Cameras and NVR
        href: https://frigate.5am.video
        siteMonitor: http://10.2.0.5:5000
        widget:
          type: frigate
          url: http://10.2.0.5:5000

    - Tunarr:
        icon: tunarr.png
        description: Live TV channels
        href: https://tunarr.5am.video
        siteMonitor: http://10.2.0.5:8000

    - Wizarr:
        icon: wizarr.png
        description: Plex invitations
        href: https://wizarr.5am.video
        siteMonitor: http://10.2.0.5:5690

# Per-site groups: wil, then ldn
- Apps (wil):
    - Website:
        icon: mdi-web
        description: Personal site
        href: https://samuel.5am.video
        siteMonitor: http://10.2.20.45:8090

    - Birdle:
        icon: mdi-bird
        description: Bird identification game
        href: https://birdle.sfc.al
        siteMonitor: http://10.2.20.45:8091

- Apps (ldn):
    - Kasm:
        icon: kasm.png
        description: Browser workspaces
        href: https://kasm.ldn.5am.cloud
        siteMonitor: https://10.3.20.50:4443

    - MicroBin:
        icon: microbin.png
        description: Pastebin
        href: https://bin.ldn.5am.cloud
        siteMonitor: http://10.3.20.50:8081

    - Restreamer:
        icon: restreamer.png
        description: Live streaming
        href: https://restreamer.ldn.5am.cloud
        siteMonitor: http://10.3.20.50:8710

    - RomM:
        icon: romm.png
        description: ROM library
        href: https://roms.ldn.5am.cloud
        siteMonitor: http://10.3.20.55:8085

    # Wolf has no web page; the check is Moonlight's server-info endpoint
    - Wolf:
        icon: mdi-controller
        description: Moonlight game streaming
        siteMonitor: http://10.3.20.55:47989/serverinfo

    # KOSync only answers requests that carry KOReader's Accept header
    - KOSync:
        icon: koreader.png
        description: KOReader progress sync
        href: https://kosync.ldn.5am.cloud
        widget:
          type: customapi
          url: http://10.3.20.70:17200/healthcheck
          headers:
            Accept: application/vnd.koreader.v1+json
          refreshInterval: 60000
          mappings:
            - field: state
              label: Health
          highlight:
            Health:
              string:
                - {level: good, when: equals, value: OK}
                - {level: danger, when: equals, value: OK, negate: true}

- Infrastructure (wil):
    - Proxmox:
        icon: proxmox.png
        description: Hypervisor
        href: https://vm.wil.5am.cloud
        siteMonitor: https://10.2.20.7:8006

    - TrueNAS:
        icon: truenas.png
        description: NAS
        href: https://nas.wil.5am.cloud
