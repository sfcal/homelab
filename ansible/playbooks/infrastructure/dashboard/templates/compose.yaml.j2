---
services:
  homepage:
    image: {{ homepage_image }}
    container_name: homepage
    restart: unless-stopped
    mem_limit: 512m
    mem_reservation: 256m
    environment:
      - TZ={{ system_timezone }}
      - PUID=1000
      - PGID=1000
      - HOMEPAGE_ALLOWED_HOSTS={{ homepage_allowed_hosts }}
      - HOMEPAGE_VAR_SONARR_KEY={{ homepage_sonarr_key }}
      - HOMEPAGE_VAR_RADARR_KEY={{ homepage_radarr_key }}
      - HOMEPAGE_VAR_BAZARR_KEY={{ homepage_bazarr_key }}
      - HOMEPAGE_VAR_PROWLARR_KEY={{ homepage_prowlarr_key }}
      - HOMEPAGE_VAR_SABNZBD_KEY={{ homepage_sabnzbd_key }}
      - HOMEPAGE_VAR_PLEX_KEY={{ homepage_plex_key }}
    # Localhost only (the VPS has a public IP); `tailscale serve` is the way in
    ports:
      - "127.0.0.1:3002:3000"
    volumes:
      - /opt/dashboard/homepage:/app/config
