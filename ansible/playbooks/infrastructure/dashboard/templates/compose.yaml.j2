---
services:
  homepage:
    image: {{ homepage_image }}
    container_name: homepage
    restart: unless-stopped
    mem_limit: 512m
    mem_reservation: 256m
    environment:
      - TZ={{ system_timezone }}
      - PUID=1000
      - PGID=1000
      - HOMEPAGE_ALLOWED_HOSTS={{ homepage_allowed_hosts }}
      - HOMEPAGE_VAR_SONARR_KEY={{ homepage_sonarr_key }}
      - HOMEPAGE_VAR_RADARR_KEY={{ homepage_radarr_key }}
      - HOMEPAGE_VAR_BAZARR_KEY={{ homepage_bazarr_key }}
      - HOMEPAGE_VAR_PROWLARR_KEY={{ homepage_prowlarr_key }}
      - HOMEPAGE_VAR_SABNZBD_KEY={{ homepage_sabnzbd_key }}
      - HOMEPAGE_VAR_PLEX_KEY={{ homepage_plex_key }}
    # Localhost only (the VPS has a public IP); `tailscale serve` is the way in
    ports:
      - "127.0.0.1:3002:3000"
    volumes:
      - /opt/dashboard/homepage:/app/config

  uptime-kuma:
    image: {{ uptime_kuma_image }}
    container_name: uptime-kuma
    restart: unless-stopped
    environment:
      - TZ={{ system_timezone }}
      # Skips the first-start database page (SQLite in /app/data)
      - UPTIME_KUMA_DB_TYPE=sqlite
    # Localhost only, like Homepage: `tailscale serve` puts it on :3001
    ports:
      - "127.0.0.1:3001:3001"
    volumes:
      - /var/lib/dashboard/uptime-kuma:/app/data

  # Public: Uptime Kuma's badges only (files/Caddyfile). Bound to the public
  # address: `tailscale serve` already holds port 80 on the tailnet address.
  caddy:
    image: {{ caddy_image }}
    container_name: caddy
    restart: unless-stopped
    ports:
      - "{{ ansible_default_ipv4.address }}:80:80"
      - "{{ ansible_default_ipv4.address }}:443:443"
    volumes:
      - /opt/dashboard/Caddyfile:/etc/caddy/Caddyfile:ro
      - /var/lib/dashboard/caddy:/data
