# oauth2-proxy: answers Caddy's login check, signs users in with Kanidm and
# keeps one session cookie per domain.
{% set gated = services | selectattr('auth', 'defined') | selectattr('auth') | map(attribute='domain') | unique | list %}
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=https://auth.5am.cloud/oauth2/openid/oauth2-proxy-{{ site }}
OAUTH2_PROXY_CLIENT_ID=oauth2-proxy-{{ site }}
OAUTH2_PROXY_CLIENT_SECRET={{ kanidm_oauth2_proxy_client_secret }}
OAUTH2_PROXY_CODE_CHALLENGE_METHOD=S256
OAUTH2_PROXY_SCOPE=openid profile
# The user has no email address; the user name stands in for it.
OAUTH2_PROXY_OIDC_EMAIL_CLAIM=preferred_username
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
OAUTH2_PROXY_UPSTREAMS=static://202
# One cookie per domain that has a flagged service, valid for 12 hours.
OAUTH2_PROXY_COOKIE_SECRET={{ oauth2_proxy_cookie_secret }}
# Renaming the cookie signs everyone out.
OAUTH2_PROXY_COOKIE_NAME=_oauth2_proxy_kanidm
OAUTH2_PROXY_COOKIE_DOMAINS={{ gated | map('regex_replace', '^', '.') | join(',') }}
OAUTH2_PROXY_WHITELIST_DOMAINS={{ gated | map('regex_replace', '^', '.') | join(',') }}
OAUTH2_PROXY_COOKIE_EXPIRE=12h
OAUTH2_PROXY_SESSION_COOKIE_MINIMAL=true
