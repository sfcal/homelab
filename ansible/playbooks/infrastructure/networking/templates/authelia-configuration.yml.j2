---
# Authelia: the login page for every service flagged `auth: true`.
# Caddy asks oauth2-proxy, and oauth2-proxy sends the browser here to log in
# (OpenID Connect), so the login works for names on any domain.
access_control:
  default_policy: one_factor

# The user and password hash are rendered by Ansible, so changing or resetting
# the password from Authelia's own pages is off.
authentication_backend:
  password_reset:
    disable: true
  password_change:
    disable: true
  file:
    path: /config/users.yml

# The login request carries the page's whole URL; the 4 KB default rejects long ones.
server:
  buffers:
    read: 32768

# Three wrong passwords lock out the address they came from, not the user.
regulation:
  modes:
    - ip

# The login page is the service entry named `auth`.
# A login lasts 12 hours, or a month with "Remember me".
session:
  expiration: 12h
  inactivity: 12h
  cookies:
{% for service in services if service.name == 'auth' %}
    - domain: {{ service.domain }}
      authelia_url: https://auth.{{ service.domain }}
{% endfor %}

storage:
  encryption_key: "{{ authelia_storage_encryption_key }}"
  local:
    path: /data/db.sqlite3

# No mail server: one-time codes (asked for when adding a 2FA device) are
# written to /var/lib/authelia/notification.txt on the host.
notifier:
  filesystem:
    filename: /data/notification.txt

# oauth2-proxy may send a browser back to any flagged service, so its list is
# every service with `auth: true`. Kasm logs in through Authelia itself, so it is
# a client of its own; its side is set in Kasm's admin UI (see the SSO docs).
identity_providers:
  oidc:
    hmac_secret: "{{ authelia_oidc_hmac_secret }}"
    jwks:
      - key: |
          {{ authelia_oidc_private_key | trim | indent(10) }}
    clients:
      - client_id: oauth2-proxy
        client_name: oauth2-proxy
        client_secret: "{{ authelia_oidc_client_secret_hash }}"
        authorization_policy: one_factor
        consent_mode: implicit
        scopes:
          - openid
          - profile
        redirect_uris:
{% for service in services if service.auth | default(false) and service.proxied | default(false) and service.enabled | default(true) %}
          - https://{{ service.name }}.{{ service.domain }}/oauth2/callback
{% endfor %}
{% for service in services if service.name == 'kasm' %}
      - client_id: kasm
        client_name: Kasm
        client_secret: "{{ authelia_oidc_kasm_client_secret_hash }}"
        authorization_policy: one_factor
        consent_mode: implicit
        scopes:
          - openid
          - profile
        redirect_uris:
          - https://{{ service.name }}.{{ service.domain }}/api/oidc_callback
{% endfor %}
