services:
  oauth2-proxy:
    image: {{ oauth2_proxy_image }}
    container_name: oauth2-proxy
    restart: unless-stopped
    env_file: /opt/oauth2-proxy/oauth2-proxy.env
    # It talks to Kanidm on the VPS over the tailnet, and the VM's own
    # resolver does not know that name.
    extra_hosts:
      - "auth.5am.cloud:{{ sites.ovh.tailnet_ip }}"
    networks:
      - caddy # no published port: only Caddy reaches it, as oauth2-proxy:4180

networks:
  caddy:
    external: true
