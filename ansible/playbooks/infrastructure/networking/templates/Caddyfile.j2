{
        admin 0.0.0.0:2019
}

# Login check for services with `auth: true`. Caddy asks oauth2-proxy; a browser
# without a session is sent to Kanidm's login page and back to where it was.
(login) {
        handle /oauth2/* {
                reverse_proxy oauth2-proxy:4180
        }
        handle {
                forward_auth oauth2-proxy:4180 {
                        uri /oauth2/auth
                        @unauthorized status 401
                        handle_response @unauthorized {
                                rewrite * /oauth2/start
                                reverse_proxy oauth2-proxy:4180 {
                                        method GET
                                        header_up X-Forwarded-Uri {http.request.orig_uri}
                                }
                        }
                }
                {block}
        }
}

{% for domain in domains %}
*.{{ domain.name }} {
        tls {
                dns cloudflare {env.CF_API_TOKEN}
                propagation_delay 2m
                resolvers 1.1.1.1
        }

{% for service in services if service.domain == domain.name and service.proxied | default(false) and service.enabled | default(true) %}
        @{{ service.name }} host {{ service.name }}.{{ domain.name }}
        handle @{{ service.name }} {
{% if service.auth | default(false) %}
                import login {
{% endif %}
{% if service.encode | default(false) %}
                encode {{ service.encode }}
{% endif %}
                reverse_proxy {{ service.backend_host }}:{{ service.backend_port }} {
{% if service.host_header | default(false) %}
                        header_up Host {upstream_hostport}
{% else %}
{#      Caddy >= 2.11 rewrites Host to the upstream IP for HTTPS upstreams;
        pin the original client Host explicitly (no-op for HTTP upstreams). #}
                        header_up Host {host}
{% endif %}
{% if service.forward_headers | default(false) %}
                        header_up X-Real-IP {remote_host}
                        header_up X-Forwarded-For {remote_host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Forwarded-Port 443
{% endif %}
{% if service.tls_skip_verify | default(false) or service.read_buffer | default(false) %}
                        transport http {
{% if service.tls_skip_verify | default(false) %}
                                tls
                                tls_insecure_skip_verify
{% endif %}
{% if service.read_buffer | default(false) %}
                                read_buffer {{ service.read_buffer }}
{% endif %}
                        }
{% endif %}
                }
{% if service.auth | default(false) %}
                }
{% endif %}
        }

{% endfor %}
}

{% endfor %}
