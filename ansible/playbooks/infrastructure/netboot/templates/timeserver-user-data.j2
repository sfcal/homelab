#cloud-config
autoinstall:
  version: 1
  # Reboot into the fresh install. The per-MAC script is always staged, but a
  # healthy node boots its local disk without touching PXE, so post-install
  # the node comes straight back up; a node that still fails local boot
  # re-runs the unattended install (reimage loop until local boot succeeds).
  shutdown: reboot
  refresh-installer:
    update: false
  locale: en_US
  keyboard:
    layout: us
  network:
    version: 2
    ethernets:
      pxe-nic:
        match:
          macaddress: "{{ ts_mac | replace('-', ':') }}"
        set-name: enp1s0
        dhcp4: false
        addresses:
          - "{{ ts_host.ip }}/24"
        routes:
          - to: default
            via: "{{ ts_host.gateway }}"
        nameservers:
          addresses:
            - "{{ ts_host.nameserver }}"
  ssh:
    install-server: true
    allow-pw: false
  storage:
    layout:
      name: direct
    swap:
      size: 0
  user-data:
    hostname: {{ ts_host.hostname }}
    timezone: {{ system_timezone }}
    users:
      - name: sfcal
        groups: [adm, sudo]
        lock_passwd: false
        sudo: ALL=(ALL) NOPASSWD:ALL
        shell: /bin/bash
        passwd: {{ netboot_user_password_hash }}
        ssh_authorized_keys:
{% for key in netboot_authorized_keys %}
          - {{ key }}
{% endfor %}
  packages:
    - sudo
    - vim
    - python3
    - openssh-server
{% if timeserver_blacklist_modules | default([]) %}
  # First boot must not bind the stock drivers to the timecard (PTM firmware
  # hang — see timeserver_blacklist_modules in group_vars). `blacklist` stops
  # the udev modalias autoload; `install ... /bin/false` also blocks explicit
  # modprobe until the driver playbook builds a compatible module, deletes
  # this file, and re-runs update-initramfs. The initramfs rebuild here bakes
  # the blacklist into the initrd, where udev coldplug would otherwise bind
  # the module before the rootfs modprobe.d is ever read.
  late-commands:
    - >-
      printf '%s\n'
{% for module in timeserver_blacklist_modules %}
      'blacklist {{ module }}' 'install {{ module }} /bin/false'
{% endfor %}
      > /target/etc/modprobe.d/blacklist-timecard.conf
    - curtin in-target -- update-initramfs -u -k all
{% endif %}
