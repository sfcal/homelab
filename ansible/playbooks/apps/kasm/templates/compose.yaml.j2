---
services:
  kasm:
    image: {{ kasm_image }}
    container_name: kasm
    privileged: true
    restart: unless-stopped
    ports:
      - "{{ kasm_port }}:{{ kasm_port }}"
      - "{{ kasm_wizard_port }}:3000"
    environment:
      - KASM_PORT={{ kasm_port }}
      - DOCKER_MTU=1500
    volumes:
      - "/var/lib/kasm/data:/opt"
      - "/var/lib/kasm/docker:/var/lib/docker"
      # Workspace image build files (the playbook's files/)
      - "/opt/kasm/images:/images:ro"

# Kasm runs its own Docker daemon inside the container and uses
# 172.17-172.19.0.0/16 internally. Pin this project's network outside
# Docker's default pool so the outer and inner subnets never overlap.
networks:
  default:
    ipam:
      config:
        - subnet: 10.90.1.0/24
