---
services:
  microbin:
    image: {{ apps.work.microbin.image }}
    container_name: microbin
    restart: unless-stopped
    ports:
      - "{{ apps.work.microbin.port }}:8080"
    volumes:
      - "/var/lib/work/microbin:/app/microbin_data"
    environment:
      - MICROBIN_PORT=8080
      - MICROBIN_PUBLIC_PATH=https://{{ apps.work.microbin.proxy.name }}.{{ apps.work.microbin.proxy.domain }}
      - MICROBIN_EDITABLE=true
      - MICROBIN_HIGHLIGHTSYNTAX=true
      - MICROBIN_PRIVATE=true
      - MICROBIN_HIDE_FOOTER=true
      - MICROBIN_MAX_FILE_SIZE_UNENCRYPTED_MB={{ apps.work.microbin.max_file_size_mb | default(2048) }}

  kasm:
    image: {{ apps.work.kasm.image }}
    container_name: kasm
    privileged: true
    restart: unless-stopped
    ports:
      - "{{ apps.work.kasm.port }}:{{ apps.work.kasm.port }}"
      - "{{ apps.work.kasm.wizard_port }}:3000"
    environment:
      - KASM_PORT={{ apps.work.kasm.port }}
      - DOCKER_MTU=1500
    volumes:
      - "/var/lib/work/kasm/data:/opt"
      - "/var/lib/work/kasm/docker:/var/lib/docker"

  restreamer:
    image: {{ apps.work.restreamer.image }}
    container_name: restreamer
    restart: unless-stopped
    mem_limit: 2g
    mem_reservation: 512m
    ports:
      - "{{ apps.work.restreamer.port }}:8080"
      - "{{ apps.work.restreamer.rtmp_port }}:1935"
      - "{{ apps.work.restreamer.srt_port }}:6000/udp"
    volumes:
      - /var/lib/work/restreamer/config:/core/config
      - /var/lib/work/restreamer/data:/core/data

# Kasm runs its own Docker daemon inside the container and uses
# 172.17-172.19.0.0/16 internally. Pin this project's network outside
# Docker's default pool so the outer and inner subnets never overlap.
networks:
  default:
    ipam:
      config:
        - subnet: 10.90.0.0/24
