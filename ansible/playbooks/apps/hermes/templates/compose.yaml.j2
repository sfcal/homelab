---
# Runs in OrbStack on the Mac mini. Deployed to /Users/smithers/hermes; the
# data folder next to it is /opt/data in both containers.
services:
  hermes:
    image: {{ hermes_image }}
    container_name: hermes
    restart: unless-stopped
    command: gateway run
    # Chromium for the browser tools needs more than Docker's 64 MB default.
    shm_size: 1g
    # The API server, for clients on the LAN (http://10.2.0.10:8642, key in
    # the data directory's .env).
    ports:
      - "8642:8642"
    environment:
      # The API server listens on every address of the container, so the web
      # UI and the published port reach it.
      API_SERVER_HOST: 0.0.0.0
      # Where the agent's file tools may write, as a colon-separated list.
      # The image's own value is /opt/data alone; this adds the writable
      # iCloud folders mounted below.
      HERMES_WRITE_SAFE_ROOT: /opt/data:/mnt/icloud/Documents/Hermes:/mnt/icloud/Documents/Projects/Homelab
    volumes:
      - /Users/smithers/hermes/data:/opt/data
      # The Documents folder of the Mac's iCloud Drive, read-only. Keep it
      # outside /opt/data: at each start the image fixes the ownership of
      # everything under /opt/data/home, and walking this folder there kept
      # the gateway from starting. If the folder is missing (iCloud signed
      # out) the container doesn't start, instead of Docker making an empty
      # folder inside iCloud Drive.
      - type: bind
        source: /Users/smithers/Library/Mobile Documents/com~apple~CloudDocs/Documents
        target: /mnt/icloud/Documents
        read_only: true
        bind:
          create_host_path: false
      # Documents/Hermes and Documents/Projects/Homelab: the two folders in
      # there that Hermes may write to.
      - type: bind
        source: /Users/smithers/Library/Mobile Documents/com~apple~CloudDocs/Documents/Hermes
        target: /mnt/icloud/Documents/Hermes
        bind:
          create_host_path: false
      - type: bind
        source: /Users/smithers/Library/Mobile Documents/com~apple~CloudDocs/Documents/Projects/Homelab
        target: /mnt/icloud/Documents/Projects/Homelab
        bind:
          create_host_path: false

  # Browser chat. Turns run in the hermes container (chat backend "gateway"),
  # so Claude Code, the plugin and the skills are the same as over Telegram.
  hermes-webui:
    image: {{ hermes_webui_image }}
    container_name: hermes-webui
    restart: unless-stopped
    depends_on:
      - hermes
    # The agent pins some package versions as uv overrides in its
    # pyproject.toml ([tool.uv]); without them its packages don't install
    # (v0.23.1: two Pillow pins that disagree). Hand uv the same list, then
    # start as the image normally does.
    command:
      - bash
      - -c
      - |
        python3 -c 'import tomllib; print("\n".join(tomllib.load(open("/opt/hermes/pyproject.toml", "rb"))["tool"]["uv"]["override-dependencies"]))' > /tmp/uv-overrides.txt && exec /hermeswebui_init.bash
    # OrbStack publishes this on the Mac's own address too: Caddy on wil's
    # networking VM reaches it at 10.2.0.10:8787.
    ports:
      - "8787:8787"
    environment:
      # Same paths and owner as in the hermes container.
      HERMES_HOME: /opt/data
      UV_OVERRIDE: /tmp/uv-overrides.txt
      HERMES_WEBUI_STATE_DIR: /opt/data/webui
      HERMES_WEBUI_DEFAULT_WORKSPACE: /opt/data/home
      WANTED_UID: "10000"
      WANTED_GID: "10000"
      HERMES_WEBUI_CHAT_BACKEND: gateway
      HERMES_WEBUI_GATEWAY_BASE_URL: http://hermes:8642
      # Shows the agent's approval prompts in the browser.
      HERMES_WEBUI_GATEWAY_USE_RUNS_API: "true"
    volumes:
      - /Users/smithers/hermes/data:/opt/data
      # Same iCloud Documents folder, at the same path as in the hermes
      # container.
      - type: bind
        source: /Users/smithers/Library/Mobile Documents/com~apple~CloudDocs/Documents
        target: /mnt/icloud/Documents
        read_only: true
        bind:
          create_host_path: false
      # Documents/Hermes and Documents/Projects/Homelab: the two folders in
      # there that Hermes may write to.
      - type: bind
        source: /Users/smithers/Library/Mobile Documents/com~apple~CloudDocs/Documents/Hermes
        target: /mnt/icloud/Documents/Hermes
        bind:
          create_host_path: false
      - type: bind
        source: /Users/smithers/Library/Mobile Documents/com~apple~CloudDocs/Documents/Projects/Homelab
        target: /mnt/icloud/Documents/Projects/Homelab
        bind:
          create_host_path: false
      # The agent's code, read-only, straight from the agent image, so it
      # always matches the version above (the web UI installs the agent's
      # Python packages from it at start).
      - type: image
        source: {{ hermes_image }}
        target: /opt/hermes
        image:
          subpath: opt/hermes

  # A real Chromium with a window, for sites Hermes needs you to log in to.
  # You see and use it at https://10.2.0.10:3001 (user hermes). Hermes drives
  # it through the proxy below (`browser.cdp_url` in its config is
  # http://tesco-chrome:9223); that port is not published.
  chrome:
    image: {{ hermes_chrome_image }}
    container_name: tesco-chrome
    # Chromium locks its profile to the hostname: keep it fixed so a
    # recreated container can open the profile.
    hostname: tesco-chrome
    restart: unless-stopped
    shm_size: 1g
    environment:
      PUID: "1000"
      PGID: "1000"
      TZ: Europe/London
      LC_ALL: en_GB.UTF-8
      CUSTOM_USER: hermes
      PASSWORD: {{ hermes_chrome_viewer_password | to_json }}
      # Chromium refuses remote debugging on its default profile, so it gets
      # one of its own. DevTools listens on 127.0.0.1:9222 in the container.
      # Everything it loads goes through Squid in ldn (apps.squid in
      # site_ldn/apps.yml): Tesco refuses wil's US address.
      CHROME_CLI: >-
        --user-data-dir=/config/hermes-profile --remote-debugging-port=9222
        --proxy-server=http://{{ groups['app_squid'] | first }}:{{ hermes_squid_port }}
        --lang=en-GB https://www.tesco.com/groceries/en-GB/
    ports:
      - "3001:3001"
    volumes:
      # A Docker volume, not a folder of the Mac: Chromium's profile is many
      # small databases.
      - chrome-config:/config

  # Chromium answers DevTools only on localhost and refuses a Host header
  # that is a name. This shares the chrome container's network, sends
  # "localhost" as Host, and rewrites the websocket addresses Chromium hands
  # back so they point at this proxy.
  chrome-cdp-proxy:
    image: {{ hermes_chrome_proxy_image }}
    container_name: tesco-chrome-cdp-proxy
    restart: unless-stopped
    network_mode: service:chrome
    depends_on:
      - chrome
    configs:
      - source: chrome_cdp_proxy
        target: /etc/nginx/nginx.conf

volumes:
  chrome-config:

# "$$" is Compose's way to write one "$".
configs:
  chrome_cdp_proxy:
    content: |
      events {}
      http {
        map $$http_upgrade $$connection_upgrade {
          default upgrade;
          ''      close;
        }
        server {
          listen 9223;
          location / {
            proxy_pass http://127.0.0.1:9222;
            proxy_http_version 1.1;
            proxy_set_header Host localhost:9222;
            proxy_set_header Origin "";
            proxy_set_header Upgrade $$http_upgrade;
            proxy_set_header Connection $$connection_upgrade;
            proxy_set_header Accept-Encoding "";
            proxy_read_timeout 1d;
            proxy_send_timeout 1d;
            sub_filter_types application/json;
            sub_filter_once off;
            sub_filter 'ws://localhost:9222/' 'ws://$$http_host/';
            sub_filter 'ws=localhost:9222/' 'ws=$$http_host/';
          }
        }
      }
