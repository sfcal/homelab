#!/usr/bin/env bash
# Managed by Ansible (playbooks/apps/cloud-gaming/templates/tv-bridge-watchdog.sh.j2).
#
# Keeps the Steam Controller usable on the Android TV Moonlight client.
# The TV runs Steam Controller Bridge, which needs Shizuku (ADB-level
# privileges). Shizuku dies on every TV reboot and cannot restart itself
# without root, so this host restarts it over network ADB and then presses the
# app's own Start button, because the bridge service is not exported and the
# boot broadcast is protected. Runs from tv-bridge-watchdog.timer.
set -u

TV="{{ tv_bridge_adb_host }}:{{ tv_bridge_adb_port }}"
BRIDGE_PKG="{{ tv_bridge_package }}"
BRIDGE_ACTIVITY="com.steamcontroller.android.MainActivity"
SHIZUKU_PKG="{{ tv_bridge_shizuku_package }}"
UI_DUMP=/sdcard/tv-bridge-ui.xml

tv() { adb -s "$TV" shell "$@" | tr -d '\r'; }
# tv() returns tr's status, so test command output rather than exit codes.
shizuku_running() { [ -n "$(tv pidof shizuku_server 2>/dev/null)" ]; }

adb connect "$TV" >/dev/null 2>&1
# `adb get-state` prints nothing for an unauthorised device, so read the list.
state=$(adb devices 2>/dev/null | awk -v d="$TV" '$1 == d { print $2 }')
case "$state" in
  device) ;;
  unauthorized)
    echo "TV rejected this host's ADB key: accept 'Allow USB debugging' on the TV with 'Always allow'"
    exit 0 ;;
  *)
    echo "TV not reachable over ADB (state: ${state:-none})"
    exit 0 ;;
esac

{% if tv_launcher_accessibility_service is defined %}
# --- Launcher accessibility service ---
# Projectivy takes over the Home button through its accessibility service.
# After a reboot this TV leaves Projectivy force-stopped and clears the
# global accessibility_enabled flag, so the service never binds and the
# stock launcher comes back. Android only binds the service once the app has
# been started and the enabled list is written again, so do both.
LAUNCHER_PKG="{{ tv_launcher_package }}"
LAUNCHER_SVC="{{ tv_launcher_accessibility_service }}"
# "Bound services" lists app labels, not component names.
launcher_bound() { tv dumpsys accessibility 2>/dev/null | grep 'Bound services' | grep -q "label={{ tv_launcher_label }}"; }
# Only repair while a launcher is in front: starting Projectivy over a running
# app (Plex, a stream) would pull the user out of it.
launcher_in_front() { tv dumpsys activity activities 2>/dev/null | grep 'mResumedActivity' | grep -q -E "launcherx|$LAUNCHER_PKG"; }
if ! launcher_bound && launcher_in_front; then
  echo "Launcher accessibility service is not bound (list: $(tv settings get secure enabled_accessibility_services 2>/dev/null)), re-registering it"
  tv am start -W -n "$LAUNCHER_PKG/{{ tv_launcher_activity }}" >/dev/null 2>&1
  sleep 3
  # adb drops an empty argument, so send the quotes for the TV shell to parse.
  tv "settings put secure enabled_accessibility_services \"\"" >/dev/null 2>&1
  sleep 1
  tv settings put secure enabled_accessibility_services "$LAUNCHER_SVC" >/dev/null 2>&1
  tv settings put secure accessibility_enabled 1 >/dev/null 2>&1
  sleep 4
  if launcher_bound; then
    echo "Launcher accessibility service bound"
  else
    echo "Launcher accessibility service still not bound"
  fi
  # The override only acts on a Home press; send one while the stock
  # launcher is still in front (nobody has opened anything yet).
  if tv dumpsys activity activities 2>/dev/null | grep 'mResumedActivity' | grep -q 'launcherx'; then
    echo "Stock launcher is in front, pressing Home for the override"
    tv input keyevent KEYCODE_HOME >/dev/null 2>&1
  fi
fi

{% endif %}
# --- Bridge service ---
# A service record alone is not enough: a failed start leaves one behind for a
# while. The service is only useful once its uinput helper (the virtual pad)
# is up.
bridge_running() {
  tv dumpsys activity services "$BRIDGE_PKG" 2>/dev/null | grep -q 'ServiceRecord.*ControllerService' &&
    [ -n "$(tv pidof "$BRIDGE_PKG:uinput" 2>/dev/null)" ]
}
if bridge_running; then
  exit 0
fi
{% if tv_bridge_manual | default(false) %}
# Manual mode: only act while the bridge app is open on the TV, i.e. the user
# picked its tile on the home screen because they want to play. Nothing
# happens on wake or boot otherwise.
if ! tv dumpsys activity activities 2>/dev/null | grep 'mResumedActivity' | grep -q "$BRIDGE_PKG"; then
  exit 0
fi
echo "Bridge app is open, connecting the controller"
{% endif %}

# --- Shizuku ---
if ! shizuku_running; then
  apk=$(tv pm path "$SHIZUKU_PKG" | sed 's/^package://')
  if [ -z "$apk" ]; then
    echo "Shizuku is not installed on the TV"
    exit 1
  fi
  # Shizuku 13 ships its starter as a native library; there is no start.sh.
  starter=$(tv "ls ${apk%/base.apk}/lib/*/libshizuku.so" | head -1)
  echo "Shizuku not running, starting $starter"
  tv "$starter" | tail -2
  sleep 3
  if ! shizuku_running; then
    echo "Shizuku did not start"
    exit 1
  fi
  echo "Shizuku started"
fi

# The bridge's helper reaches Shizuku through the Shizuku app's content
# provider. When the server dies, Shizuku's own starter force-stops the app,
# which puts the package in Android's stopped state and hides the provider
# ("provider is null"). Launching the app once clears that state.
if ! tv content call --uri content://"$SHIZUKU_PKG".shizuku --method ping 2>&1 | grep -q '^Result'; then
  echo "Shizuku provider not reachable, launching the Shizuku app to clear its stopped state"
  tv am start -W -n "$SHIZUKU_PKG/moe.shizuku.manager.MainActivity" >/dev/null 2>&1
  sleep 2
  tv input keyevent KEYCODE_BACK >/dev/null 2>&1
fi

if ! tv dumpsys usb 2>/dev/null | grep -q 'Steam Controller'; then
  echo "Bridge service not running and no Steam Controller on USB, nothing to do"
  exit 0
fi
if ! tv dumpsys power 2>/dev/null | grep -q 'mWakefulness=Awake'; then
  echo "Bridge service not running but the TV is asleep, retrying later"
  exit 0
fi

echo "Bridge service not running, starting it through the app"
# The app's uinput helper is spawned through Shizuku (shell uid) and outlives
# the app; a stale one would leave a dead duplicate pad for Moonlight to find.
stale=$(tv pidof "$BRIDGE_PKG:uinput" 2>/dev/null)
if [ -n "$stale" ]; then
  echo "Killing stale uinput helper ($stale)"
  tv kill $stale >/dev/null 2>&1
fi
# An app process that came up before Shizuku (the boot receiver starts it)
# keeps a dead Shizuku binder, so start it fresh.
tv am force-stop "$BRIDGE_PKG" >/dev/null 2>&1
sleep 1
tv am start -W -n "$BRIDGE_PKG/$BRIDGE_ACTIVITY" >/dev/null 2>&1
sleep 3

# Find the Start/Stop button and tap its centre. The TV fork lays the button
# out as btnToggleService; uiautomator reports its bounds as [x1,y1][x2,y2].
dump=$(tv "uiautomator dump $UI_DUMP >/dev/null 2>&1; cat $UI_DUMP; rm -f $UI_DUMP")
node=$(grep -o '<node[^>]*btnToggleService[^>]*' <<<"$dump" | head -1)
if [ -z "$node" ]; then
  echo "Could not find the Start button in the app UI"
  tv input keyevent KEYCODE_BACK >/dev/null 2>&1
  exit 1
fi
if grep -q 'text="Stop Service"' <<<"$node"; then
  echo "App reports the service as running"
else
  read -r x1 y1 x2 y2 < <(grep -o 'bounds="[^"]*"' <<<"$node" | tr -c '0-9\n' ' ')
  tv input tap $(( (x1 + x2) / 2 )) $(( (y1 + y2) / 2 )) >/dev/null 2>&1
  sleep 4
  # First start after a reboot may bring up the TV's USB access dialog.
  if tv dumpsys window 2>/dev/null | grep -q 'UsbPermission'; then
    dump=$(tv "uiautomator dump $UI_DUMP >/dev/null 2>&1; cat $UI_DUMP; rm -f $UI_DUMP")
    ok=$(grep -o '<node[^>]*android.widget.Button[^>]*' <<<"$dump" | grep -i -E 'text="(OK|Allow|Yes)"' | head -1)
    if [ -n "$ok" ]; then
      read -r x1 y1 x2 y2 < <(grep -o 'bounds="[^"]*"' <<<"$ok" | tr -c '0-9\n' ' ')
      echo "Accepting the USB access dialog"
      tv input tap $(( (x1 + x2) / 2 )) $(( (y1 + y2) / 2 )) >/dev/null 2>&1
      sleep 4
    fi
  fi
fi

{% if not (tv_bridge_manual | default(false)) %}
tv input keyevent KEYCODE_BACK >/dev/null 2>&1
{% endif %}
for _ in 1 2 3 4 5 6; do
  if bridge_running; then
    echo "Bridge service started"
    exit 0
  fi
  sleep 2
done
echo "Bridge service did not start"
exit 1
