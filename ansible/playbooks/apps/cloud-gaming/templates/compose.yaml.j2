---
# Matches the upstream quickstart compose (games-on-whales/wolf, stable).
# Wolf runs as root in this container and spawns the app containers as
# siblings through the Docker socket; it maps /etc/wolf and its runtime dir
# back to host paths by introspecting its own container, so no host path is
# passed in. State lives in {{ wolf_data_path }}/state on the host.
services:
  wolf:
    image: {{ wolf_image }}
    container_name: wolf
    restart: unless-stopped
    network_mode: host
    environment:
      - TZ={{ system_timezone }}
      - WOLF_LOG_LEVEL={{ wolf_log_level }}
      - WOLF_RENDER_NODE={{ wolf_render_node }}
    volumes:
      - {{ wolf_data_path }}/state:/etc/wolf:rw
      - /var/run/docker.sock:/var/run/docker.sock:rw
      - /dev/:/dev/:rw
      - /run/udev:/run/udev:rw
    device_cgroup_rules:
      - 'c 13:* rmw'
    devices:
      - /dev/dri
      - /dev/uinput
      - /dev/uhid
