{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "matchCategories": [
        "docker"
      ],
      "enabled": true,
      "pinDigests": false
    },
    {
      "description": "Auto-merge patch immediately",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "minimumReleaseAge": "0 days",
      "automergeType": "pr"
    },
    {
      "description": "Auto-merge minor after 1 day",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true,
      "minimumReleaseAge": "1 day",
      "automergeType": "pr"
    },
    {
      "description": "Auto-merge major after 3 days",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true,
      "minimumReleaseAge": "3 days",
      "automergeType": "pr"
    },
    {
      "description": "Auto-merge GitHub Actions immediately",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true,
      "minimumReleaseAge": "0 days",
      "automergeType": "pr"
    },
    {
      "description": "Keep kasm below 1.100: its Dec 2022 tags (1.120.2022xxxx) sort above the real 1.1x versions. Never automerge: a new image doesn't upgrade Kasm until the in-app update is run from the wizard",
      "matchPackageNames": [
        "lscr.io/linuxserver/kasm"
      ],
      "allowedVersions": "<1.100.0",
      "automerge": false
    },
    {
      "description": "kosync mixes 2- and 3-part tags (v2.1, v2.1.1); docker versioning would never offer v2.2/v3.0 from a 3-part pin",
      "matchPackageNames": [
        "koreader/kosync"
      ],
      "versioning": "loose"
    },
    {
      "description": "Kanidm upgrades go one minor version at a time and can't be rolled back: open the PR, never automerge",
      "matchPackageNames": [
        "kanidm/server"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Ansible group_vars Docker image references",
      "managerFilePatterns": [
        "/ansible/inventory/group_vars/.+\\.yml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\n\\s*\\w+:\\s*\"(?<depName>[^:]+):(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "docker"
    }
  ],
  "hostRules": [
    {
      "hostType": "docker",
      "matchHost": "docker.io",
      "username": "{{ secrets.DOCKER_HUB_USERNAME }}",
      "password": "{{ secrets.DOCKER_HUB_PASSWORD }}"
    }
  ],
  "schedule": [
    "before 6am every weekday"
  ],
  "minimumReleaseAge": "1 day",
  "minimumReleaseAgeBehaviour": "timestamp-optional"
}
